# ---------- Sumber data ----------
SOURCES=youtube_trend,maps,tiktok,instagram
REPLAY_INTERVAL_SECONDS=4

# ---------- YouTube (tren) ----------
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA=10000
YT_SEARCH_RESERVE_UNITS=6000
YT_TREND_LOOKBACK_DAYS=90
YT_SEARCH_DATE_PAGES=2
YT_SEARCH_REFRESH_HOURS=6
YT_MAX_VIDEOS_PER_TOPIC=150
YT_STATS_INTERVAL_MINUTES=60
YT_COMMENTS_ENABLED=false
YT_MAX_COMMENTS_PER_VIDEO=15
ACCEPTED_VIDEO_TYPES=review
YT_STRICT_REVIEW_FILTER=true
YOUTUBE_HTTP_TIMEOUT_SECONDS=10

# ---------- Google Maps (opini) ----------
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_EMBED_KEY=
MAPS_PROVIDER=apify
APIFY_TOKEN=
APIFY_ACTOR_ID=compass~crawler-google-places
APIFY_POLL_INTERVAL_SECONDS=5
APIFY_POLL_TIMEOUT_SECONDS=600
MAPS_LANGUAGE=id
MAPS_REGION=ID
MAPS_MAX_PAGES=2
MAPS_MAX_PLACES_PER_SEARCH=3
MAPS_MAX_REVIEWS_PER_PLACE=10
MAPS_REFRESH_HOURS=8
MAPS_DAILY_REQUEST_CAP=30
MAPS_MONTHLY_REQUEST_CAP=800
MAPS_CONTENT_TTL_DAYS=7
DEFAULT_CITY=Bandung

# ---------- TikTok & Instagram via Apify ----------
TIKTOK_ACTOR_ID=clockworks~tiktok-scraper
INSTAGRAM_ACTOR_ID=apify~instagram-scraper
SOCIAL_RESULTS_PER_QUERY=50
SOCIAL_MAX_QUERIES_PER_TOPIC=3
SOCIAL_LOOKBACK_DAYS=30
SOCIAL_REFRESH_HOURS=12
SOCIAL_DAILY_RUN_CAP=12
SOCIAL_MONTHLY_RUN_CAP=300
SOCIAL_COMMENTS_ENABLED=false

# ---------- Mode demo ----------
DEMO_MODE=false
DEMO_STATS_INTERVAL_SECONDS=120
DEMO_BUDGET_UNITS=1500

# ---------- Topik ----------
MAX_ACTIVE_TOPICS=5

# ---------- AI ----------
AI_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM=8
BATCH_SIZE=25
BATCH_MAX_WAIT_SECONDS=10
MAX_GEMINI_FAILURES=3
VIDEO_CLASSIFIER=auto
SUMMARY_MIN_REVIEWS=10

# ---------- Umum ----------
DATABASE_PATH=data/app.db
MAX_COMMENT_CHARS=800
DEFAULT_WINDOW=90d
LOG_LEVEL=INFO
